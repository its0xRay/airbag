# Airbag environment variables (copy to Railway/Vercel; never commit real secrets)

# ---- Railway: quote-service (web) + keeper ----
# Devnet RPC both services use. Public works; a paid QuickNode/Helius is faster.
RPC_URL=https://api.devnet.solana.com
# Enable only after RPC_URL is configured and the /rpc boundary has been tested.
RPC_PROXY_ENABLED=false
# Deployed program id (already baked into the code; override only if you redeploy).
PROGRAM_ID=Ad2TFKtNNzzxcApDZVHdMTVoucSUczNAstfV4ywL1wky
# Mainnet RPC for market reference data. Public works.
MAINNET_RPC=https://api.mainnet-beta.solana.com

# ---- SECRETS (Railway → each service → Variables). JSON arrays of 64 bytes. ----
# Get the exact values from DEPLOY-SECRETS.local.md (generated locally, gitignored).
QUOTE_AUTHORITY_SECRET=[...]   # quote-service
PUBLISHER_SECRET=[...]         # keeper
TRIAL_BUDGET_SECRET=[...]      # quote-service (sponsored transaction fees)
ADMIN_SECRET=[...]             # quote-service (demo-token mint authority)

# ---- Trial budget tuning (optional) ----
TRIAL_CAP_SOL=20
TRIAL_PER_GRANT_SOL=0.3
TRIAL_PER_WALLET_SOL=0.6
# Persistent volume path. On Railway, mount a volume at /data.
TRIAL_STATE_PATH=/data/trial-budget-state.json
# Separate persistent volume on the keeper service (not the web volume).
KEEPER_STATE_PATH=/data/keeper-observations.json

# The keeper accepts only qualifying live reference observations. There is no
# environment switch for synthetic reference prices.

# ---- Vercel: frontend (VITE_ vars are baked at build time) ----
VITE_RPC_URL=https://api.devnet.solana.com
# true routes client RPC through VITE_QUOTE_SVC/rpc; no provider key in the bundle.
VITE_USE_RPC_RELAY=false
VITE_QUOTE_SVC=https://YOUR-QUOTE-SERVICE.up.railway.app
